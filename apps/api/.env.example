# API — variables de entorno (copiar a .env)
# Postgres local (docker compose desde la raíz del repo)
DATABASE_URL="postgresql://stackforge:stackforge@localhost:5432/stackforge?schema=public"

# Puerto HTTP de la API
PORT=4000

# Completar en fases posteriores (AI / Storage S3)
# AI_PROVIDER=free
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=stackforge
# S3_SECRET_KEY=stackforge-secret
# S3_BUCKET=submissions

# Autenticación JWT (generá secretos largos; en este repo .env local ya trae valores)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false