{
  "name": "stackforge",
  "version": "0.1.0",
  "private": true,
  "description": "StackForge — Plataforma Fullstack Learning. Monorepo.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev --workspace @stackforge/api\" \"npm run dev --workspace @stackforge/web\"",
    "dev:api": "npm run dev --workspace @stackforge/api",
    "dev:web": "npm run dev --workspace @stackforge/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace @stackforge/api",
    "db:generate": "npm run prisma:generate --workspace @stackforge/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
